# ==============================================================================
# Variáveis de Ambiente Obrigatórias - Chopits Fullstack
# ==============================================================================
# ATENÇÃO: O projeto adota a arquitetura Fail-Fast.
# NÃO existem fallbacks silenciosos para portas, URLs ou credenciais.
# Se qualquer uma das variáveis abaixo não for definida, o sistema falhará
# imediatamente no início da execução indicando onde a configuração está ausente.
# ==============================================================================

# Porta da API Mock exposta no Host
API_PORT=3002

# Porta do Frontend Web exposta no Host
FRONTEND_PORT=80

# URL Base para comunicação com a API REST
# Para Docker (produção com proxy reverso Nginx): /api
# Para desenvolvimento local nativo: http://localhost:3002
VITE_API_BASE_URL=/api
