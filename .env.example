# ===============================================
# Variáveis de Ambiente - Chopits Fullstack
# ===============================================

# Porta exposta no Host para a API Mock (JSON-Server)
# Padrão: 3002 (evita conflito com projetos na porta 3001)
API_PORT=3002

# Porta exposta no Host para o Frontend Web (Nginx)
# Padrão: 80
FRONTEND_PORT=80

# URL Base para comunicação do Axios no Frontend
# No Docker (produção via Nginx reverse proxy): /api
# No ambiente local tradicional: http://localhost:3001
VITE_API_BASE_URL=/api
