FROM node:22-alpine

WORKDIR /app

# Instala wget para suporte a healthcheck de container
RUN apk add --no-cache wget

# Copia manifestos de dependências
COPY package.json package-lock.json* ./

# Instala apenas as dependências de runtime necessárias
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

# Copia base de dados mock e scripts
COPY jsonserver ./jsonserver
COPY scripts ./scripts

# Expõe a porta padrão do JSON-Server
EXPOSE 3001

# Executa o JSON-Server escutando em todas as interfaces de rede (0.0.0.0)
CMD ["npx", "json-server", "jsonserver/dados.json", "--port", "3001", "--host", "0.0.0.0"]
